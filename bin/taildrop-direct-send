#!/bin/bash

# Delegate Taildrop sends to omarchy-tailscale-send, keeping drag-and-drop
# file passing from the Network Hub panel. Address peers hostname-first
# (DNS name or short host), matching upstream's peerAddress() ordering.
set -euo pipefail

if (($# == 0)); then
  exit 0
fi

machine="$1"
shift

exec omarchy-tailscale-send "$machine" "$@"
